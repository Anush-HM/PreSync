# Copy this file to backend/.env and fill in the values.
# backend/.env is gitignored; never commit real secrets.

# Port the API, Socket.IO and Yjs servers listen on
PORT=4000

# MongoDB connection string (a local mongod works fine)
MONGO_URI=mongodb://localhost:27017/presync

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Comma-separated list of frontend origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Anthropic API key. Optional. Used by the audience Q&A drafter and by
# AI Copilot in the editor. Without it, the Q&A drafter replies
# NOT_IN_DECK and Copilot shows a setup message; nothing else changes.
# The key stays on the server and is never sent to the browser.
ANTHROPIC_API_KEY=

# --- AI Copilot (all optional) ---
# Provider adapter to use. Only "anthropic" is implemented today.
AI_PROVIDER=anthropic
# Model Copilot asks. Defaults to claude-opus-5-5.
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Higher is slower and costs more.
AI_EFFORT=medium
# Longest reply, in tokens (1000-32000).
AI_MAX_OUTPUT_TOKENS=8000
# Copilot requests each signed-in user may make per minute.
AI_RATE_LIMIT_PER_MINUTE=10
# "default" retries a declined request on Anthropic's recommended
# fallback model; "off" sends plain requests.
AI_REFUSAL_FALLBACK=default
# Save Copilot conversations (per user and deck, without slide content).
AI_STORE_HISTORY=true
# Set to false to switch Copilot off even when a key is present.
AI_COPILOT_ENABLED=true
