# Copy this file to backend/.env and fill in the values.
# backend/.env is gitignored; never commit real secrets.

# Port the API, Socket.IO and Yjs servers listen on
PORT=4000

# MongoDB connection string (a local mongod works fine)
MONGO_URI=mongodb://localhost:27017/presync

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Comma-separated list of frontend origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Anthropic API key for drafting audience Q&A answers.
# Optional: without it, the Q&A drafter replies NOT_IN_DECK.
ANTHROPIC_API_KEY=
